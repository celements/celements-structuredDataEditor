<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>com.celements</groupId>
    <artifactId>celements-parent</artifactId>
    <version>7.1</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>structuredDataEditor-web</artifactId>
  <version>7.1-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>Celements Structured Data Editor Web-Module</name>
  <description>	</description>
  <licenses>
    <license>
      <name>LGPL 2.1</name>
      <url>http://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:git@github.com:celements/celements-structuredDataEditor.git</connection>
    <developerConnection>scm:git:git@github.com:celements/celements-structuredDataEditor.git</developerConnection>
    <url>https://github.com/celements/celements-structuredDataEditor/web-module</url>
    <tag>HEAD</tag>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.celements</groupId>
      <artifactId>celements-structuredDataEditor</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>structuredDataEditor-web</finalName>
    <plugins>
      <plugin>
        <groupId>com.jarslab.maven</groupId>
	<artifactId>babel-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>js-transpile</id>
            <configuration>
              <babelSrc>${project.basedir}/babel-jslib/babel.min.js</babelSrc>
              <targetDir>${project.basedir}/target/${project.build.finalName}/resources/</targetDir>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
